<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!-- Norse versions -->
		<AsgardVersion>0.0.16</AsgardVersion>
		<BragiVersion>0.0.3</BragiVersion>
		<HeimdallVersion>0.0.7</HeimdallVersion>
		<HiminbjorgVersion>0.0.8</HiminbjorgVersion>
		<MidgardVersion>0.0.7</MidgardVersion>
		<MimirVersion>0.0.0</MimirVersion>
		<MimisbrunnrVersion>0.0.6</MimisbrunnrVersion>
		<NaglfarVersion>0.0.4</NaglfarVersion>
		<RatatoskrVersion>0.0.0</RatatoskrVersion>
		<SvartalfheimVersion>0.0.8</SvartalfheimVersion>
		<UrdarbrunnrVersion>0.0.7</UrdarbrunnrVersion>
		<!-- 3rd party versions -->
		<BlazingStoryVersion>1.0.0-preview.89</BlazingStoryVersion>
		<ContainerVersion>11.0-preview-resolute-chiseled-extra</ContainerVersion>
		<DotNetVersion>11.0.0-preview.6.26359.118</DotNetVersion>
		<FluentUIVersion>5.0.0-rc.4-26180.1</FluentUIVersion>
		<GrpcVersion>2.80.0</GrpcVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="BlazingStory" Version="$(BlazingStoryVersion)" />
		<PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="$(GrpcVersion)" />
		<PackageVersion Include="Grpc.Net.Client" Version="$(GrpcVersion)" />
		<PackageVersion Include="Grpc.Net.Client.Web" Version="$(GrpcVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotNetVersion)" />
		<PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="$(FluentUIVersion)" />
		<PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="$(FluentUIVersion)" />
		<PackageVersion Include="protobuf-net.Grpc" Version="1.2.5" />
		<!-- Svartalfheim -->
		<PackageVersion Include="Norse.Primitives" Version="$(SvartalfheimVersion)" />
		<PackageVersion Include="Norse.Primitives.Ingestion" Version="$(SvartalfheimVersion)" />
		<!-- Asgard -->
		<PackageVersion Include="Norse.Abstractions.Backend" Version="$(AsgardVersion)" />
		<PackageVersion Include="Norse.Abstractions.Components" Version="$(AsgardVersion)" />
		<PackageVersion Include="Norse.Abstractions.Contracts" Version="$(AsgardVersion)" />
		<PackageVersion Include="Norse.Abstractions.Migrations" Version="$(AsgardVersion)" />
		<PackageVersion Include="Norse.Abstractions.Web.Server" Version="$(AsgardVersion)" />
		<PackageVersion Include="Norse.Abstractions.Worker" Version="$(AsgardVersion)" />
		<!-- Urdarbrunnr — widened from the old single Norse.EntityFramework.Migrations.PostgreSQL into
		     a provider-agnostic base plus per-provider design/runtime siblings (2026-07-22 rename). -->
		<PackageVersion Include="Norse.Persistence.EntityFramework" Version="$(UrdarbrunnrVersion)" />
		<PackageVersion Include="Norse.Persistence.EntityFramework.Design" Version="$(UrdarbrunnrVersion)" />
		<PackageVersion Include="Norse.Persistence.EntityFramework.Design.PostgreSQL" Version="$(UrdarbrunnrVersion)" />
		<PackageVersion Include="Norse.Persistence.EntityFramework.Design.SqlServer" Version="$(UrdarbrunnrVersion)" />
		<PackageVersion Include="Norse.Persistence.EntityFramework.PostgreSQL" Version="$(UrdarbrunnrVersion)" />
		<PackageVersion Include="Norse.Persistence.EntityFramework.SqlServer" Version="$(UrdarbrunnrVersion)" />
		<!-- Midgard -->
		<PackageVersion Include="Norse.Infrastructure.Components.Theme" Version="$(MidgardVersion)" />
		<PackageVersion Include="Norse.Infrastructure.Components.Theme.FluentUI" Version="$(MidgardVersion)" />
		<PackageVersion Include="Norse.Infrastructure.Migrations" Version="$(MidgardVersion)" />
		<PackageVersion Include="Norse.Infrastructure.Web.Client" Version="$(MidgardVersion)" />
		<PackageVersion Include="Norse.Infrastructure.Web.Server" Version="$(MidgardVersion)" />
		<!-- Himinbjorg — base Identity.Migrations is IsPackable=false now (superseded by the
		     provider siblings); base Identity project was deleted, folded into Identity.Web.Server. -->
		<PackageVersion Include="Norse.Identity.Migrations.PostgreSQL" Version="$(HiminbjorgVersion)" />
		<PackageVersion Include="Norse.Identity.Migrations.SqlServer" Version="$(HiminbjorgVersion)" />
		<PackageVersion Include="Norse.Identity.Web.Server" Version="$(HiminbjorgVersion)" />
		<!-- Mimisbrunnr — Norse.ReferenceData.Data.Migrations renamed to Norse.Reference.Data.Migrations,
		     plus new Norse.Reference.Data (base entities) and provider siblings. -->
		<PackageVersion Include="Norse.Reference.Data" Version="$(MimisbrunnrVersion)" />
		<PackageVersion Include="Norse.Reference.Data.Migrations" Version="$(MimisbrunnrVersion)" />
		<PackageVersion Include="Norse.Reference.Data.Migrations.PostgreSQL" Version="$(MimisbrunnrVersion)" />
		<PackageVersion Include="Norse.Reference.Data.Migrations.SqlServer" Version="$(MimisbrunnrVersion)" />
		<!-- Heimdall — was entirely absent; HeimdallVersion prop existed but nothing consumed it. -->
		<PackageVersion Include="Norse.AuthN.Components" Version="$(HeimdallVersion)" />
		<PackageVersion Include="Norse.AuthN.Components.FluentUI" Version="$(HeimdallVersion)" />
		<PackageVersion Include="Norse.AuthN.Services" Version="$(HeimdallVersion)" />
		<!-- Naglfar / Bragi -->
		<PackageVersion Include="Norse.DesignSystem.Stories" Version="$(BragiVersion)" />
		<PackageVersion Include="Norse.DesignSystem.Tokens" Version="$(NaglfarVersion)" />

	</ItemGroup>
</Project>
