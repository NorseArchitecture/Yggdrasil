<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!-- Dev-mode attachment (UseProjectReferences=true) for NORSE080. Reachable-but-unregistered
		     gRPC service types (protobuf-net, Norse.Infrastructure.Web.Grpc) are resolvable in this
		     project's compilation via Hosting.Web.Client even though no hand-written code touches
		     them yet — exactly the "reachable but not yet gated" case NORSE080 exists to catch before
		     code gets written here, mirroring how the original defect was found in a test fixture. -->
		<NorseGeneratorRef Include="Infrastructure.Web.Grpc.Analyzers">
			<Repo>Midgard</Repo>
		</NorseGeneratorRef>
		<!-- Task 14's proof-by-adding-one: whitelists Infrastructure.Web.Client.Generator so it is
		     NOT stripped from this project's own compilation (the default for every generator
		     forwarded transitively via the ProjectReference to Hosting.Web.Client below — see
		     _NorseRemoveUnwantedGeneratorAnalyzers in Yggdrasil's Directory.Build.targets). Running it
		     again here, with DiscoveryFixture also referenced (below), proves the generator composes
		     correctly against a consumer other than the host project it was written for — the
		     regression lock this fixture exists to carry. This mints a second
		     NorseClientComponentRegistration.AddNorseClientComponents(), in this project's own
		     Norse.Hosting.Web.Client.Tests namespace, alongside the one already compiled into
		     Hosting.Web.Client.dll (namespace Norse.Hosting.Web.Client). An unqualified call does NOT
		     fail to compile — C#'s extension-method lookup walks outward from the innermost enclosing
		     namespace and stops at the first non-empty candidate set, so it silently and
		     deterministically binds to the nearer (.Tests) copy, no CS0121, no warning. Both
		     DiscoveryFixtureCompositionTests.cs and CompositionTests.cs (the latter fixed after a
		     reviewer caught it silently rebinding this exact way) call their generated type by fully
		     qualified name — not to dodge a compiler error, but to pin exactly which of the two real
		     copies is under test. -->
		<!-- Reviewer-verified 2026-08-07: CompositionTests.cs's own AddNorseGrpcClients(channel) call
		     rebound the same way once this whitelist landed (silently, no diagnostic) — confirmed via
		     IL inspection before the fix. Left as a live example of exactly the failure mode described
		     above, not a hypothetical. -->
		<NorseGeneratorRef Include="Infrastructure.Web.Client.Generator">
			<Repo>Midgard</Repo>
		</NorseGeneratorRef>
		<!-- Direct reference (CI-mode attachment) so NORSE080's bundled analyzer isn't stripped by
		     NuGet's default transitive exclude — it only reaches this project through
		     Hosting.Web.Client, which doesn't survive the trip in standalone/package mode. Plain
		     PackageReference + Version, not NorseRef — NorseRef never belongs in tests/
		     (CPM is deliberately off here), same convention as Hosting.Web.Server.Tests.csproj.
		     Condition="UseProjectReferences != true" is load-bearing, not decorative: in Bifröst
		     dev-mode this project already reaches a FRESH Infrastructure.Web.Grpc transitively via
		     the ProjectReference to Hosting.Web.Client below — Version="*" floats to the
		     latest PUBLISHED package, which predates WireModelRegistrationGuard's existence until
		     Midgard actually releases, and un-conditioned this collides with the fresh project
		     reference and breaks the local build. Scoped to standalone/CI mode only. -->
		<PackageReference Include="Norse.Infrastructure.Web.Grpc" Version="*" Condition="'$(UseProjectReferences)' != 'true'" />
		<ProjectReference Include="..\..\src\Hosting.Web.Client\Hosting.Web.Client.csproj" />
		<!-- Task 14's proof-by-adding-one fixture — never referenced by a host project itself. -->
		<ProjectReference Include="..\DiscoveryFixture\DiscoveryFixture.csproj" />
	</ItemGroup>
</Project>
