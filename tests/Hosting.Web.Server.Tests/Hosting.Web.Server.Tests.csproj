<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- NU1605 local-dev-mode false positive: from Bifrost root, UseProjectReferences=true turns
		     every NorseRef this project reaches transitively (Hosting.Web.Server to Identity.Web.Server
		     to Persistence.EntityFramework.PostgreSQL) into a ProjectReference. NuGet's restore-time
		     downgrade check reads that referenced project's static $(Version), evaluated before
		     MinVer's target ever runs, which is the plain SDK default "1.0.0", not the real
		     git-tag-derived version. That collides with this project's explicit VersionOverride below
		     (0.0.9, the real published version) as a spurious "downgrade". CI never sees this: it
		     restores the real published Norse.Persistence.EntityFramework.PostgreSQL package (no
		     ProjectReference, no MinVer timing gap), so the pin above is what actually governs there. -->
		<NoWarn>$(NoWarn);NU1605</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.*-*" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.*-*" />
		<!-- NorseRef never belongs in tests/ (CPM is deliberately off here) — Norse package
		     references pin an explicit VersionOverride directly instead, same as Testcontainers.PostgreSql
		     below. 0.0.9 mirrors each realm's current Directory.Packages.props pin at the time of writing;
		     bump by hand alongside the next real version pin. -->
		<PackageReference Include="Norse.Persistence.EntityFramework.PostgreSQL" VersionOverride="0.0.9" />
		<PackageReference Include="Norse.Reference.Data.EntityFramework.Migrations" VersionOverride="0.0.9" />
		<PackageReference Include="Norse.Reference.Data.Namespaces" VersionOverride="0.0.9" />
		<!-- Not CPM-pinned (halt-and-ask gate on Directory.Packages.props, Task 13): VersionOverride
		     pins this one third-party package for this project without touching the central file.
		     4.13.0 mirrors the version every other realm's own PostgresContainerFixture already
		     resolves via its own (non-CPM) csproj. -->
		<PackageReference Include="Testcontainers.PostgreSql" VersionOverride="4.13.0" />
		<ProjectReference Include="..\..\src\Hosting.Web.Server\Hosting.Web.Server.csproj" />
	</ItemGroup>
</Project>
