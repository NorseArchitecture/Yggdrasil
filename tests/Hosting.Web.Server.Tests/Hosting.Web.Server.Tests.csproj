<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- AddOpenApi's bundled XML-doc-comment source generator (Task 13's SwoopHostFixture is this
		     project's first AddOpenApi call) emits interceptors; needs this opt-in explicitly, mirroring
		     Midgard's own Infrastructure.Web.Server.Tests.csproj fix for the identical generator. -->
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>
	<ItemGroup>
		<NorseGeneratorRef Include="Infrastructure.Web.Server.Generator">
			<Repo>Midgard</Repo>
		</NorseGeneratorRef>
		<NorseGeneratorRef Include="Infrastructure.Web.Grpc.Analyzers">
			<Repo>Midgard</Repo>
		</NorseGeneratorRef>
		<!-- NorseRefs, not floating packages: the workspace crossing must migrate with the InitialCreate that matches the
		     local identity model, or MachineAuthPostgresFixture refuses the published one as pending model changes. -->
		<NorseRef Include="Identity.Migrations">
			<Repo>Himinbjorg</Repo>
		</NorseRef>
		<NorseRef Include="Identity.Migrations.PostgreSQL">
			<Repo>Himinbjorg</Repo>
		</NorseRef>
		<!-- TEMPORARY (2026-10-24): lifts the transitive HyperTabular to the CPM 0.9.0 pin. The Mimisbrunnr
		     migrations packages on the feed were packed against HyperTabular 0.8.0, so on the package
		     crossing NuGet takes 0.8.0 for it while Hosting.Web.Server brings HyperCast 0.9.0 — a mixed
		     native layout, and DelimitedReader.FillStep throws "libhypertabular reported a contract
		     violation". Delete this line once Mimisbrunnr ships a release packed against 0.9.0. -->
		<PackageReference Include="HyperTabular" Version="*" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.*-*" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.*-*" />
		<PackageReference Include="Microsoft.Playwright" Version="*" />
		<PackageReference Include="Norse.Infrastructure.Web.Grpc" Version="*" Condition="'$(UseProjectReferences)' != 'true'" />
		<PackageReference Include="Norse.Persistence.EntityFramework.PostgreSQL" Version="*" />
		<PackageReference Include="Norse.Persistence.EntityFramework.Design" Version="*" />
		<PackageReference Include="Norse.Reference.Data.EntityFramework.Migrations" Version="*" />
		<PackageReference Include="Norse.Reference.Data.EntityFramework.Migrations.PostgreSQL" Version="*" />
		<PackageReference Include="Norse.Reference.Data.Namespaces" Version="*" />
		<PackageReference Include="Testcontainers.PostgreSql" Version="*" />
		<ProjectReference Include="..\..\src\Hosting.Web.Server\Hosting.Web.Server.csproj" />
		<Compile Include="../BrowserTesting/*.cs" Link="BrowserTesting/%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
