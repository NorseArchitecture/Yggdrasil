<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:$(ContainerVersion)</ContainerBaseImage>
	</PropertyGroup>

	<ItemGroup>
		<!-- Deliberate direct reference, version-pin-only: FakeAuthenticationService moved to Bragi
		     (DesignSystem.Stories, registered via AddNorseStoryFakes) so this composition root no
		     longer consumes IAuthenticationService in code. The ref stays because Bragi's package
		     carries its own baked transitive floor on Norse.AuthN.Services that NuGet's nearest-wins
		     resolution would otherwise pick over our CPM pin — the direct ref plus the CPM pin at
		     $(HeimdallVersion) keeps this composition root's pin authoritative. Unverified against a
		     real NU1608 in this shape (2026-08-22): inside the Bifröst workspace NorseRef forwards to
		     local project references, so no package-version comparison can fire here regardless —
		     re-check in a standalone/package-mode restore post-tag. -->
		<NorseRef Include="AuthN.Services">
			<Repo>Heimdall</Repo>
		</NorseRef>
		<NorseRef Include="DesignSystem.Stories">
			<Repo>Bragi</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.Components.Theme.FluentUI">
			<Repo>Midgard</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.ServiceDefaults.AspNet">
			<Repo>Midgard</Repo>
		</NorseRef>
		<PackageReference Include="BlazingStory" />
		<PackageReference Include="BlazingStory.McpServer" />
	</ItemGroup>

</Project>
