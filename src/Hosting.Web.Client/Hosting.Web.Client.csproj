<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
	</PropertyGroup>

	<ItemGroup>
		<NorseRef Include="Abstractions.Contracts">
			<Repo>Asgard</Repo>
		</NorseRef>
		<NorseRef Include="AuthN.Components.FluentUI">
			<Repo>Heimdall</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.Components.Theme.FluentUI">
			<Repo>Midgard</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.Web.Client" Generator="true">
			<Repo>Midgard</Repo>
		</NorseRef>
		<!-- Direct reference (CI-mode attachment) so NORSE080's bundled analyzer isn't stripped by
		     NuGet's default transitive exclude — it previously only reached this project through
		     Infrastructure.Web.Client, which doesn't survive the trip in standalone/package mode. -->
		<NorseRef Include="Infrastructure.Web.Grpc">
			<Repo>Midgard</Repo>
		</NorseRef>
		<!-- Dev-mode attachment (UseProjectReferences=true) — the NorseRef above covers CI/standalone. -->
		<NorseGeneratorRef Include="Infrastructure.Web.Grpc.Analyzers">
			<Repo>Midgard</Repo>
		</NorseGeneratorRef>
		<NorseRef Include="Reference.Contracts">
			<Repo>Mimir</Repo>
		</NorseRef>
		<PackageReference Include="Grpc.Net.Client" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
		<!-- Overrides the stale >= 2.4.8 transitive floor protobuf-net.Grpc 1.2.5 declares for
		     plain protobuf-net. -->
		<PackageReference Include="protobuf-net" />
		<PackageReference Include="protobuf-net.Grpc" />
		<ProjectReference Include="..\Hosting.Web.Components\Hosting.Web.Components.csproj" />
	</ItemGroup>

</Project>
