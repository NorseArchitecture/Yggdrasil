@page "/reference/country-lookup"
@using System.Globalization
@inherits AsyncComponentBase
@inject IReferenceService ReferenceService

<PageTitle>Country Lookup</PageTitle>

<h1>Country Lookup</h1>

<p>
	Resolves a country by any ISO 3166-1 code form (alpha-2, alpha-3, or numeric — padded or
	unpadded) over the wire, then recomputes the same identifier locally from
	<code>MimirNamespaces.Iso3166</code> to prove the two land on the identical
	<code>DeterministicGuid</code>.
</p>

<FluentTextInput @bind-Value="_code" Label="Code" Placeholder="US, USA, 840, 40..." />
<FluentButton Appearance="ButtonAppearance.Primary" OnClick="LookupAsync">Look up</FluentButton>

@if (_errorMessage is not null)
{
	<FluentMessageBar Intent="MessageBarIntent.Error">@_errorMessage</FluentMessageBar>
}

@if (_response is not null)
{
	<dl>
		<dt>Alpha-2</dt>
		<dd>@_response.Alpha2</dd>
		<dt>Alpha-3</dt>
		<dd>@_response.Alpha3</dd>
		<dt>Name</dt>
		<dd>@_response.Name</dd>
		<dt>Wire Id</dt>
		<dd>@_response.Id</dd>
	</dl>

	@if (_recomputedId is { } recomputedId)
	{
		<p>
			Client-recomputed Id: @recomputedId
			@if (recomputedId == _response.Id)
			{
				<FluentBadge Appearance="BadgeAppearance.Filled">Match</FluentBadge>
			}
			else
			{
				<FluentBadge Appearance="BadgeAppearance.Outline">Mismatch</FluentBadge>
			}
		</p>
	}
}

@code {
	string _code = "";
	string? _errorMessage;
	CountryResponse? _response;
	Guid? _recomputedId;

	async Task LookupAsync()
	{
		_errorMessage = null;
		_response = null;
		_recomputedId = null;

		var outcome = await ReferenceService.GetCountry(new() { Code = _code }, CancellationToken);

		if (outcome.TryGetValue(out Failed failed))
		{
			_errorMessage = failed.Problem.Category switch
			{
				ErrorCategory.Validation => $"'{_code}' is not a recognized ISO 3166-1 code.",
				ErrorCategory.NotFound => $"'{_code}' parsed, but no seeded country matches it.",
				_ => "The lookup failed.",
			};
			return;
		}

		_response = outcome.Match(static response => response, static _ => null!);

		// The wire response carries no numeric code, deliberately (CountryResponse's shape is fixed
		// wire law) -- re-parsing the same user-typed code through the same generated IsoCountryCodes
		// parser the server used, then zero-padding its own numeric value to three digits, reproduces
		// the exact string CountryQueryHandler fed into Iso3166.Ids server-side, so recomputing
		// DeterministicGuid from it here is a genuine independent proof, not a copy of the wire value.
		if (IsoCountryCodes.Parse(_code).TryGetValue(out Success<IsoCountryCode> success))
		{
			var numericCode = ((ushort)success.Value).ToString("D3", CultureInfo.InvariantCulture);
			DeterministicGuid local = new(MimirNamespaces.Iso3166, numericCode);
			_recomputedId = local.Value;
		}
	}
}
