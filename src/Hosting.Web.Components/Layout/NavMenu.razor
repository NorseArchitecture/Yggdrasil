@using System.Security.Claims
@using Norse.AuthN.Services

<FluentNav Id="main-menu" Width="260px">
    <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())"
                   IconActive="@(new Icons.Filled.Size20.Home())">
        Home
    </FluentNavItem>
    <FluentNavCategory Title="Template">
        <FluentNavItem Href="counter" IconRest="@(new Icons.Regular.Size20.NumberSymbolSquare())"
                       IconActive="@(new Icons.Filled.Size20.NumberSymbolSquare())">
            Counter
        </FluentNavItem>
        <FluentNavItem Href="weather" IconRest="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())"
                       IconActive="@(new Icons.Filled.Size20.WeatherPartlyCloudyDay())">
            Weather
        </FluentNavItem>
        <FluentNavItem Href="auth" IconRest="@(new Icons.Regular.Size20.LockClosedKey())"
                       IconActive="@(new Icons.Filled.Size20.LockClosedKey())">
            Auth Required
        </FluentNavItem>
    </FluentNavCategory>
    <FluentNavCategory Title="Reference">
        <FluentNavItem Href="reference/country-lookup" IconRest="@(new Icons.Regular.Size20.Globe())"
                       IconActive="@(new Icons.Filled.Size20.Globe())">
            Country Lookup
        </FluentNavItem>
    </FluentNavCategory>
    @* The anonymous-cookie principal is authenticated, so the block is gated on the account tier the pages
       themselves require, never on authentication alone. *@
    <AuthorizeView Policy="@AuthNPolicies.Account">
        <Authorized>
            <FluentNavItem Href="Account/Manage">@AccountLabel(context.User)</FluentNavItem>
            <NavLink href="Account/Logout">Logout</NavLink>
        </Authorized>
    </AuthorizeView>
</FluentNav>


@code {
	static string AccountLabel(ClaimsPrincipal user) =>
		new[] { user.FindFirst(ClaimTypes.Email)?.Value, user.Identity?.Name }
			.FirstOrDefault(static label => !string.IsNullOrWhiteSpace(label)) ?? "Account";
}
