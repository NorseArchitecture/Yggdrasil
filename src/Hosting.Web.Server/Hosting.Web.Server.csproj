<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:$(ContainerVersion)</ContainerBaseImage>
		<!-- AddOpenApi's bundled XML-doc-comment source generator (Task 11 in Midgard) emits
		     interceptors; needs this opt-in explicitly, same fix Infrastructure.Web.Server.Tests.csproj
		     already carries for the identical generator. -->
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Contracts">
			<Repo>Asgard</Repo>
		</NorseRef>
		<NorseRef Include="Abstractions.Web.Server">
			<Repo>Asgard</Repo>
		</NorseRef>
		<NorseRef Include="AuthN.Components.FluentUI">
			<Repo>Heimdall</Repo>
		</NorseRef>
		<NorseRef Include="Identity.Web.Server">
			<Repo>Himinbjorg</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.Backend">
			<Repo>Midgard</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.Components.Theme.FluentUI">
			<Repo>Midgard</Repo>
		</NorseRef>
		<!-- Midgard-blind Mímir (NORSE071 remediation): AddWell<ReferenceDbContext>() is the
		     composition root's own call now, right after AddNorseReferenceService in Program.cs. -->
		<NorseRef Include="Infrastructure.Persistence.EntityFramework">
			<Repo>Midgard</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.ServiceDefaults.AspNet">
			<Repo>Midgard</Repo>
		</NorseRef>
		<NorseRef Include="Infrastructure.Web.Server" Generator="true">
			<Repo>Midgard</Repo>
		</NorseRef>
		<NorseRef Include="Reference.Data.EntityFramework">
			<Repo>Mimisbrunnr</Repo>
		</NorseRef>
		<NorseRef Include="Reference.Web.Server">
			<Repo>Mimir</Repo>
		</NorseRef>
		<PackageReference Include="Grpc.AspNetCore.Web" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
		<!-- Overrides the stale >= 2.4.8 transitive floor protobuf-net.Grpc 1.2.5 declares for
		     plain protobuf-net. -->
		<PackageReference Include="protobuf-net" />
		<PackageReference Include="protobuf-net.Grpc.AspNetCore.Reflection" />
		<PackageReference Include="Scalar.AspNetCore" />
		<ProjectReference Include="..\Hosting.Web.Client\Hosting.Web.Client.csproj" />
	</ItemGroup>
</Project>
