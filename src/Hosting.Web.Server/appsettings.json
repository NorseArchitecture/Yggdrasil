{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "OpenIddict": {
      "Pruning": {
        "Enabled": true,
        "Interval": "01:00:00",
        "MinimumAge": "14.00:00:00"
      }
    }
  },
  "Norse": {
    "Authentication": {
      "RecentWindow": "00:10:00"
    }
  }
}
